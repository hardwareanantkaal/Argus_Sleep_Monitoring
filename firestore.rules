rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // No accounts/ownership in this app — deviceHistory/{deviceId}/history/{sessionId}
    // is the public archive the 30-minute sync job mirrors completed sleep sessions
    // into (see historySyncJob.js), open the same way Realtime Database is: anyone
    // can read or write any device's history, matching the app's public-access model.
    match /deviceHistory/{deviceId}/{document=**} {
      allow read, write: if true;
    }

    // manufacturedDevices/{macNoColons} is written by the separate Argus manufacturing
    // app when a unit is flashed (chip, firmware, who flashed it — claimed: false).
    // This app no longer reads/writes it (device claiming was removed), but the rules
    // below are left in place since the manufacturing app may still rely on them.
    match /manufacturedDevices/{macNoColons} {
      allow read: if request.auth != null;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["claimed", "claimedByEmail", "claimedAt"])
        && (
          // Claim: false -> true, claiming as yourself.
          (resource.data.claimed == false
            && request.resource.data.claimed == true
            && request.resource.data.claimedByEmail == request.auth.token.email)
          ||
          // Rollback: true -> false, only by whoever just claimed it — used when the
          // follow-up users/{email}/devices link write fails, so a claim never gets
          // stuck with no actual owner.
          (resource.data.claimed == true
            && resource.data.claimedByEmail == request.auth.token.email
            && request.resource.data.claimed == false
            && request.resource.data.claimedByEmail == null)
        );

      allow create, delete: if false;
    }
  }
}
