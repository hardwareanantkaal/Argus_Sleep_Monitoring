rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // users/{email} holds the registration profile, plus subcollections:
    //   devices/{deviceId}         devices this user has linked (deviceId = MAC address)
    //   devices/{deviceId}/history/{sessionId}   mirrored sleep sessions for that device
    // Document ID is the user's email address (not the Firebase Auth uid).
    // The users/{email}/devices linking mechanism itself allows the same deviceId
    // under multiple users, but in practice a device can only be registered once —
    // see manufacturedDevices below, which gates registration to a single claim.
    match /users/{email}/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    // manufacturedDevices/{macNoColons} is written by the separate Argus manufacturing
    // app when a unit is flashed (chip, firmware, who flashed it — claimed: false).
    // This consumer app only needs to read it (to check a scanned/typed MAC is a real
    // device) and flip claimed false -> true once, when a user registers it — never
    // create, delete, or touch the manufacturing-owned fields (chip, firmware*, flashedBy*).
    match /manufacturedDevices/{macNoColons} {
      allow read: if request.auth != null;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["claimed", "claimedByEmail", "claimedAt"])
        && (
          // Claim: false -> true, claiming as yourself.
          (resource.data.claimed == false
            && request.resource.data.claimed == true
            && request.resource.data.claimedByEmail == request.auth.token.email)
          ||
          // Rollback: true -> false, only by whoever just claimed it — used when the
          // follow-up users/{email}/devices link write fails, so a claim never gets
          // stuck with no actual owner.
          (resource.data.claimed == true
            && resource.data.claimedByEmail == request.auth.token.email
            && request.resource.data.claimed == false
            && request.resource.data.claimedByEmail == null)
        );

      allow create, delete: if false;
    }
  }
}
